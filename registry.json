    "workflows": [
      {
        "name": "Automate a story on staging",
        "steps": [
          {
            "step": "User gives an Azure story link",
            "component": "V-01"
          },
          {
            "step": "Read the story and acceptance criteria",
            "component": "V-05"
          },
          {
            "step": "Locate backend spec, frontend and existing tests",
            "component": "V-05"
          },
          {
            "step": "Compare coverage and fill the checklist",
            "component": "V-05"
          },
          {
            "step": "Add or extend tests",
            "component": "V-05"
          },
          {
            "step": "Check the edit and test selection",
            "component": "V-13"
          },
          {
            "step": "Confirm test data is ready",
            "component": "V-10"
          },
          {
            "step": "Run the selected tests on staging",
            "component": "V-02"
          },
          {
            "step": "Record a skip when data is missing",
            "component": "V-14"
          },
          {
            "step": "Collect results",
            "component": "V-15"
          },
          {
            "step": "Debug failures, fix the test, rerun",
            "component": "V-06"
          },
          {
            "step": "Review coverage against the story",
            "component": "V-07"
          },
          {
            "step": "Hand over the short report",
            "component": "V-05"
          }
        ]
      },
      {
        "name": "Run specific tests",
        "steps": [
          {
            "step": "User gives test IDs",
            "component": "V-02"
          },
          {
            "step": "Check each ID is selected exactly once",
            "component": "V-13"
          },
          {
            "step": "Run on staging",
            "component": "V-02"
          },
          {
            "step": "Write the story results summary",
            "component": "V-15"
          }
        ]
      },
      {
        "name": "Debug a failed run",
        "steps": [
          {
            "step": "User gives a run link or local report",
            "component": "V-03"
          },
          {
            "step": "Find the first action that differs from the story",
            "component": "V-06"
          },
          {
            "step": "Classify: automation, product, data or environment",
            "component": "V-06"
          },
          {
            "step": "Fix the test and rerun the affected IDs",
            "component": "V-02"
          }
        ]
      },
      {
        "name": "Review coverage",
        "steps": [
          {
            "step": "User gives a story and changed tests",
            "component": "V-04"
          },
          {
            "step": "Map requirements to test IDs and check each assertion",
            "component": "V-07"
          },
          {
            "step": "Compare planned IDs with the actual run",
            "component": "V-07"
          },
          {
            "step": "Deliver findings, most serious first",
            "component": "V-07"
          }
        ]
      }
    ]
